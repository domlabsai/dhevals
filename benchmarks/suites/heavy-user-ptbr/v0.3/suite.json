  "tasks": [
    {
      "id": "research-conflicting-evidence",
      "title": "Research under conflicting evidence",
      "category": "Research",
      "prompt": "Analise duas evidências conflitantes sobre uma decisão de busca corporativa. Separe fatos de inferências, explicite incerteza, indique o que ainda precisa ser verificado e recomende o próximo experimento. Não invente fontes.",
      "checks": [
        {
          "id": "decision-structure",
          "type": "contains_all",
          "values": [
            "evidências",
            "incerteza",
            "recomendação"
          ]
        },
        {
          "id": "minimum-evidence",
          "type": "min_length",
          "characters": 240
        }
      ],
      "rubric": [
        {
          "id": "grounding",
          "label": "Grounding",
          "weight": 0.45
        },
        {
          "id": "uncertainty",
          "label": "Incerteza",
          "weight": 0.25
        },
        {
          "id": "decision-utility",
          "label": "Utilidade para decisão",
          "weight": 0.3
        }
      ],
      "metadata": {
        "expected_artifact": "decision_memo",
        "publication": "calibration",
        "input_ref": "synthetic/research-conflict-01"
      }
    },
    {
      "id": "document-version-compare",
      "title": "Document version comparison",
      "category": "Documents",
      "prompt": "Compare duas versões de um brief operacional. Retorne somente JSON válido com versao_a, versao_b, mudancas, conflitos e rastreabilidade. Diferencie mudança de texto, mudança de prazo e conflito não resolvido.",
      "checks": [
        {
          "id": "valid-structure",
          "type": "json_object",
          "required_keys": [
            "versao_a",
            "versao_b",
            "mudancas",
            "conflitos",
            "rastreabilidade"
          ]
        },
        {
          "id": "conflict-preserved",
          "type": "contains_any",
          "values": [
            "conflito",
            "contraditório",
            "contraditorio"
          ]
        }
      ],
      "rubric": [
        {
          "id": "fidelity",
          "label": "Fidelidade",
          "weight": 0.4
        },
        {
          "id": "traceability",
          "label": "Rastreabilidade",
          "weight": 0.35
        },
        {
          "id": "format",
          "label": "Formato",
          "weight": 0.25
        }
      ],
      "metadata": {
        "expected_artifact": "change_log_json",
        "publication": "calibration",
        "input_ref": "synthetic/document-versions-01"
      }
    },
    {
