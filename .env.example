# SaciLM / RunPod — never commit a real key.
DHEVALS_SACILM_BASE_URL=https://your-runpod-endpoint/v1
DHEVALS_SACILM_API_KEY=
DHEVALS_SACILM_MODEL_ID=sacilm
DHEVALS_SACILM_PROVIDER=runpod-openai-compatible
DHEVALS_SACILM_CHECKPOINT=sacilm-checkpoint-or-revision
DHEVALS_SACILM_RUNTIME=Unsloth + vLLM on RunPod
DHEVALS_SACILM_TRAINING_COMMIT=post-training-git-sha
DHEVALS_SACILM_MODEL_MANIFEST=benchmarks/models/sacilm/v0.1/model.json
DHEVALS_SACILM_TEMPERATURE=0.2
DHEVALS_SACILM_MAX_TOKENS=2048
DHEVALS_SACILM_SEED=7
# Keep the SaciLM lane out of current readiness gates until development starts.
DHEVALS_SACILM_EVALUATION_MODE=standby
# Optional USD per 1,000 tokens; quality score is independent of cost.
DHEVALS_SACILM_INPUT_COST_PER_1K=
DHEVALS_SACILM_OUTPUT_COST_PER_1K=

# Optional manifest finalization once the checkpoint is frozen.
# DHEVALS_SACILM_MANIFEST_OUTPUT=benchmarks/models/sacilm/v0.1/model-ready.json
# DHEVALS_SACILM_BASE_MODEL_ID=
# DHEVALS_SACILM_BASE_MODEL_LICENSE=
# DHEVALS_SACILM_CHECKPOINT_REVISION=
# DHEVALS_SACILM_CHECKPOINT_SHA256=
# DHEVALS_SACILM_DATASET_SHA256=
# DHEVALS_SACILM_DATASET_LICENSE=
# DHEVALS_SACILM_QUANTIZATION=4bit-nf4
# DHEVALS_SACILM_LORA=r=16-alpha=32
# DHEVALS_SACILM_SEQUENCE_LENGTH=4096
# DHEVALS_SACILM_PACKING=true
# DHEVALS_SACILM_HARDWARE=A100-80GB
# DHEVALS_SACILM_RUNTIME_IMAGE=ghcr.io/...@sha256:...

# Optional comparison baseline.
DHEVALS_BASELINE_BASE_URL=
DHEVALS_BASELINE_API_KEY=

# Generic model lane (HTTP or local CLI); never commit credentials.
# DHEVALS_MODEL_ID=qwen-local
# DHEVALS_MODEL_PROVIDER=qwen-cli
# DHEVALS_MODEL_ADAPTER=command-line
# DHEVALS_MODEL_CLI_COMMAND=qwen --model Qwen3-32B
# DHEVALS_MODEL_CLI_PROMPT_MODE=stdin
# DHEVALS_MODEL_CLI_TIMEOUT_SECONDS=120
# DHEVALS_MODEL_SUITE_PATH=benchmarks/suites/heavy-user-ptbr/v0.3/suite.json
# DHEVALS_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# DHEVALS_MODEL_API_KEY_ENV=DHEVALS_MODEL_API_KEY

# Optional independent LLM-as-a-Judge lane; never commit a real key.
DHEVALS_JUDGE_BASE_URL=
DHEVALS_JUDGE_API_KEY=
DHEVALS_JUDGE_MODEL_ID=judge
