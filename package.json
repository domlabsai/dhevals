{
  "name": "dhevals-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-public-projection.mjs && node scripts/sync-public-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-public-projection.mjs && node scripts/sync-public-docs.mjs",
    "build": "vite build",
    "prepreview": "node scripts/sync-public-docs.mjs",
    "preview": "vite preview",
    "test:public-docs": "node scripts/test-public-docs.mjs",
    "build:public-projection": "node scripts/build-public-projection.mjs",
    "test:public-projection": "node scripts/test-public-projection.mjs",
    "test:production-bundle": "node scripts/test-production-bundle.mjs",
    "test:benchmarks": "uv run --python 3.12 --project packages/dhevals_core python -m unittest discover -s packages/dhevals_core/tests -v",
    "test:cli-adapter": "uv run --python 3.12 --project packages/dhevals_core python -m unittest packages.dhevals_core.tests.test_cli_adapter -v",
    "test:model-cli": "node scripts/test-model-cli-wrapper.mjs",
    "run:fixture": "node scripts/run-fixture.mjs",
    "run:calibration": "node scripts/run-calibration-fixture.mjs",
    "run:negative": "node scripts/run-negative-fixture.mjs",
    "audit:benchmarks": "node scripts/audit-benchmarks.mjs",
    "scaffold:expanded": "node scripts/scaffold-heavy-user-v03.mjs",
    "audit:expanded": "node scripts/audit-heavy-user-v03.mjs",
    "run:expanded": "node scripts/run-heavy-user-v03-fixture.mjs",
    "run:negative:v03": "node scripts/run-heavy-user-v03-negative.mjs",
    "build:suite-catalog": "node scripts/build-suite-catalog.mjs",
    "build:run-catalog": "node scripts/build-run-catalog.mjs",
    "build:model-catalog": "node scripts/build-model-catalog.mjs",
    "build:dataset-catalog": "node scripts/build-dataset-catalog.mjs",
    "build:experiment-catalog": "node scripts/build-experiment-catalog.mjs",
    "build:comparison-execution": "node scripts/build-comparison-execution.mjs",
    "audit:goal": "node scripts/audit-dhevals-goal.mjs",
    "test:goal-audit": "node scripts/test-goal-audit.mjs",
    "build:scorecard": "node scripts/build-scorecard.mjs",
    "build:calibration-review-data": "node scripts/build-calibration-review-data.mjs",
    "build:calibration-handoff": "node scripts/build-calibration-handoff.mjs",
    "build:test-matrix": "node scripts/build-test-matrix.mjs build",
    "validate:test-matrix": "node scripts/build-test-matrix.mjs validate",
    "test:matrix": "node scripts/run-test-matrix.mjs",
    "test:independent": "node scripts/test-independent-evals.mjs",
    "test:judge-runner": "node scripts/test-judge-runner.mjs",
    "validate:sacilm-manifest": "uv run --python 3.12 --project packages/dhevals_core dhevals-model validate --manifest benchmarks/models/sacilm/v0.1/model.json",
    "validate:sacilm-ready": "uv run --python 3.12 --project packages/dhevals_core dhevals-model validate --require-ready --manifest benchmarks/models/sacilm/v0.1/model.json",
    "finalize:sacilm-manifest": "node scripts/finalize-sacilm-manifest.mjs",
    "test:manifest-finalizer": "node scripts/test-manifest-finalizer.mjs",
    "test:calibration-import": "node scripts/test-calibration-import-adjudication.mjs",
    "test:calibration-ready": "node scripts/test-calibration-ready-wrapper.mjs",
    "test:calibration-handoff": "node scripts/test-calibration-handoff.mjs",
    "test:sacilm-wrapper": "node scripts/test-sacilm-archive-wrapper.mjs",
    "test:sacilm-promotion": "node scripts/test-sacilm-promotion-wrapper.mjs",
    "test:sacilm-promotion-ready": "node scripts/test-sacilm-promotion-ready-wrapper.mjs",
    "test:comparison-wrapper": "node scripts/test-comparison-wrapper.mjs",
    "test:comparison-promotion": "node scripts/test-comparison-promotion-wrapper.mjs",
    "build:release-gate": "node scripts/build-release-gate.mjs",
    "check:release": "DHEVALS_RELEASE_GATE_STRICT=1 node scripts/build-release-gate.mjs",
    "preflight:sacilm": "node scripts/preflight-sacilm.mjs",
    "check:sacilm-readiness": "node scripts/check-sacilm-readiness.mjs",
    "test:sacilm-preflight": "node scripts/test-sacilm-preflight-wrapper.mjs",
    "test:sacilm-e2e": "node scripts/test-sacilm-e2e-wrapper.mjs",
    "run:sacilm": "node scripts/run-sacilm.mjs",
    "run:model": "node scripts/run-model.mjs",
    "run:comparison": "node scripts/run-comparison.mjs",
    "build:report": "node scripts/build-report-artifacts.mjs",
    "build:calibration": "node scripts/build-calibration-progress.mjs",
    "import:calibration:v02": "node scripts/import-calibration-v02.mjs",
    "import:calibration:v03": "node scripts/import-calibration-v03.mjs",
    "export:calibration:v02": "uv run --python 3.12 --project packages/dhevals_core dhevals-calibration-sheet export-blind --rubric benchmarks/calibration/heavy-user-ptbr/v0.2/anchor-rubric.json --examples benchmarks/calibration/heavy-user-ptbr/v0.2/anchor-examples.json --output-dir reports/calibration/heavy-user-ptbr-v0.2-blind --manifest-output reports/calibration/heavy-user-ptbr-v0.2-blind/pack.json",
    "export:calibration:v03": "uv run --python 3.12 --project packages/dhevals_core dhevals-calibration-sheet export-blind --rubric benchmarks/calibration/heavy-user-ptbr/v0.3/anchor-rubric.json --examples benchmarks/calibration/heavy-user-ptbr/v0.3/anchor-examples.json --output-dir reports/calibration/heavy-user-ptbr-v0.3-blind --manifest-output reports/calibration/heavy-user-ptbr-v0.3-blind/pack.json",
    "build:leaderboard": "node scripts/build-leaderboard.mjs",
    "api": "node scripts/dhevals-api-server.mjs",
    "test:api": "node scripts/test-dhevals-api.mjs",
    "verify:run": "node scripts/verify-run.mjs",
    "test:e2e": "playwright test",
    "test:platform": "node scripts/test-platform-e2e.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
